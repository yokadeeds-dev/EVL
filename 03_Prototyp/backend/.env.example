# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# API-Keys für Authentifizierung (kommagetrennt)
USER_API_KEYS=key-user-abc123,key-user-def456
ADMIN_API_KEYS=key-admin-xyz789

# Rate-Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Pfad zur Wissensbasis
KNOWLEDGE_BASE_PATH=./knowledge_base

# ChromaDB Persistenz-Pfad (lokal, on-premise)
CHROMA_PATH=./chroma_db

# Modell
LLM_MODEL=claude-opus-4-5-20251101

# CORS-Origin für das Frontend
ALLOWED_ORIGIN=http://localhost:5173
