# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# JWT Secret (mind. 32 zufällige Zeichen – z.B. via: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=bitte-hier-einen-langen-zufaelligen-string-eintragen

# Rate-Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Redis — prozessuebergreifendes Rate-Limiting + LLM-Response-Cache.
# Leer lassen = In-Memory-Fallback (kein Redis noetig, z.B. lokal/CI).
REDIS_URL=redis://localhost:6379/0
LLM_CACHE_TTL_SECONDS=3600

# Postgres + pgvector — geteilter RAG-Vektorstore (prozessuebergreifend).
# Leer lassen = In-Memory-Fallback (kein Postgres noetig, z.B. lokal ohne DB).
DATABASE_URL=postgresql://evl:evl@localhost:5432/evl

# Pfad zur Wissensbasis
KNOWLEDGE_BASE_PATH=./knowledge_base

# Modell (verfügbare Modelle: claude-opus-4-5, claude-sonnet-4-5, claude-haiku-3-5)
LLM_MODEL=claude-opus-4-5

# CORS-Origin für das Frontend
ALLOWED_ORIGIN=http://localhost:5173
